.fav-root {
    flex: 1 1 auto;
    flex-direction: column;
}

.fav-tabs-row {
    flex-direction: row;
    align-items: flex-end;
    padding: 2px 2px 0 2px;
    background-color: rgba(0, 0, 0, 0.15);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.5);
}

.fav-tabs-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.fav-tabs-scroll > .unity-scroll-view__vertical-scroller {
    display: none;
}

.fav-tabs-scroll .unity-scroll-view__content-viewport {
    flex-direction: column;
}

.fav-tabs-scroll .unity-scroll-view__content-container {
    flex-direction: row;
    align-items: center;
}

.fav-tabs-container {
    flex-direction: row;
    align-items: center;
}

.fav-tab {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding-left: 10px;
    padding-right: 10px;
    margin-right: 2px;
    margin-top: 2px;
    height: 20px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 0;
    border-color: rgba(0, 0, 0, 0.5);
    background-color: rgba(60, 60, 60, 0.6);
    cursor: link;
}

.fav-tab-label {
    color: rgb(220, 220, 220);
    -unity-font-style: bold;
    flex-shrink: 0;
    white-space: nowrap;
}

.fav-tab--active {
    border-color: rgb(255, 255, 255);
}

.fav-add-tab {
    width: 22px;
    height: 22px;
    margin-left: 4px;
    flex-shrink: 0;
    -unity-font-style: bold;
    font-size: 13px;
    padding: 0;
}

.fav-list-container {
    flex: 1 1 auto;
    position: relative;
}

.fav-items-list {
    flex: 1 1 auto;
}

.fav-item {
    flex-direction: row;
    align-items: center;
    padding-left: 2px;
    padding-right: 2px;
    height: 22px;
}

.fav-tab--dragging {
    opacity: 0.35;
}

.fav-tab--ghost {
    opacity: 0.85;
    margin: 0;
}

.unity-list-view__reorderable-handle,
.unity-list-view__reorderable-handle-bar {
    width: 10px;
    min-width: 10px;
    margin-left: 2px;
    margin-right: 2px;
    padding-left: 0;
    padding-right: 0;
    align-self: center;
}

.unity-list-view__reorderable-item__container {
    padding-left: 2px;
    padding-right: 2px;
}

.fav-item-ping {
    width: 16px;
    height: 16px;
    min-width: 16px;
    flex-shrink: 0;
    margin: 0 2px 0 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.fav-item-ping:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

.fav-item-body {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-text-align: middle-left;
}

.fav-item-body:hover {
    background-color: rgba(0, 0, 0, 0);
}

.fav-item-icon {
    width: 20px;
    height: 20px;
    min-width: 20px;
    max-width: 20px;
    flex-shrink: 0;
    margin-right: 4px;
    position: relative;
}

.fav-item-icon-bg,
.fav-item-icon-fg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.fav-item-icon--composite .fav-item-icon-bg {
    right: 30%;
    bottom: 30%;
    opacity: 0.35;
}

.fav-item-icon--composite .fav-item-icon-fg,
.fav-item-icon--composite .fav-item-icon-fg-shadow {
    top: 30%;
    left: 30%;
}

.fav-item-icon-fg-shadow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
    --unity-image-tint-color: rgba(0, 0, 0, 0.9);
    translate: -1px -1px;
}

.fav-item--thumb {
    height: 48px;
}

.fav-item--unresolved .fav-item-icon,
.fav-item--unresolved .fav-item-label {
    opacity: 0.5;
}

.fav-item--thumb .fav-item-icon {
    width: 40px;
    height: 40px;
    min-width: 40px;
    max-width: 40px;
}

.fav-item--thumb .fav-item-inline-icon {
    width: 24px;
    height: 24px;
    min-width: 24px;
    max-width: 24px;
}

.fav-item--thumb .fav-item-label,
.fav-item--thumb .fav-item-label-container {
    font-size: 14px;
}

.fav-item-label-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.fav-item-label {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
    -unity-text-align: middle-left;
}

.fav-item-label-container {
    flex-shrink: 0;
    margin: 0 0 0 0;
    color: rgba(200, 200, 200, 0.75);
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.fav-item-inline-icon {
    width: 16px;
    height: 16px;
    min-width: 16px;
    max-width: 16px;
    flex-shrink: 0;
    margin: 0;
}

.fav-item-delete {
    width: 16px;
    height: 16px;
    min-width: 16px;
    flex-shrink: 0;
    margin-left: 4px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.fav-item-delete:hover {
    background-color: rgba(255, 80, 80, 0.18);
}

.fav-empty-hint {
    position: absolute;
    top: 50%;
    left: 8px;
    right: 8px;
    -unity-text-align: middle-center;
    color: rgba(200, 200, 200, 0.4);
    -unity-font-style: italic;
    white-space: normal;
}

.fav-drop-target {
    background-color: rgba(80, 140, 255, 0.15);
}

.fav-drag-cancel-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.55);
}


.fav-drag-cancel-icon {
    width: 32px;
    height: 32px;
    margin-bottom: 6px;
    --unity-image-tint-color: rgb(255, 120, 120);
}

.fav-drag-cancel-label {
    color: rgb(230, 230, 230);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}
